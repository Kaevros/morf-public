<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>../../src/Widgates/Assets/Brand/morf.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Widgates/*.cs" Exclude="../../src/Widgates/Program.cs" Link="Product/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/Widgates/Assets/Brand/*.png" LogicalName="Widgates.Brand.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
